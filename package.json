{
  "name": "purix-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "purix": "turbo run build --filter=purix... && pnpm --filter purix exec tsx src/cli.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "boundary-check": "node --import tsx scripts/check-core-boundary.ts",
    "artifact-check": "node --import tsx scripts/check-no-toolchain-artifacts.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-include=\"packages/core/src/{llm,licensing,gates,sandbox,verify}/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" \"packages/core/src/{llm,licensing,gates,sandbox,verify}/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "expect": "^29.7.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.16.0",
      "fast-uri": ">=3.1.6"
    }
  }
}
