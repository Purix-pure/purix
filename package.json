{
  "name": "purix-monorepo",
  "version": "0.2.0-beta.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "purix": "turbo run build --filter=@purix/cli... && pnpm --filter @purix/cli exec tsx src/cli.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "boundary-check": "node --import tsx scripts/check-core-boundary.ts",
    "artifact-check": "node --import tsx scripts/check-no-toolchain-artifacts.ts",
    "lint": "turbo run build --filter=@purix/core && eslint .",
    "lint:fix": "turbo run build --filter=@purix/core && eslint . --fix",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-include=\"packages/core/src/{llm,licensing,gates,sandbox,verify}/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" \"packages/core/src/{llm,licensing,gates,sandbox,verify}/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "eslint": "^9.39.0",
    "expect": "^29.7.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cross-spawn": "^7.0.6"
  },
  "description": "Governance-first AI coding agent platform. Purix classifies and verifies AI-driven code modifications *before* they run — in a sandbox, against your test suite, with a human confirmation checkpoint for anything risky — rather than applying a change and hoping it was safe.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}