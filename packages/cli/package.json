{
  "name": "@purix/cli",
  "version": "0.4.0-beta.3",
  "description": "Governance-first AI coding agent CLI: classifies and verifies AI-driven code changes in a sandbox, against your test suite, before they land. Also runs as an MCP server for other coding agents.",
  "keywords": [
    "ai",
    "cli",
    "code-verification",
    "governance",
    "mcp",
    "model-context-protocol",
    "sandbox",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "mcpName": "io.github.Purix-pure/purix",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Purix-pure/purix.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Purix-pure/purix#readme",
  "bugs": {
    "url": "https://github.com/Purix-pure/purix/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "verifier",
    "NOTICE"
  ],
  "bin": {
    "purix": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "purix": "tsx src/cli.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@purix/core": "workspace:^0.4.0-beta.3",
    "@purix/mcp-server": "workspace:^0.4.0-beta.3",
    "add-mcp": "^2.6.1",
    "commander": "^15.1.0",
    "cross-spawn": "catalog:",
    "dotenv": "^17.4.2",
    "ts-morph": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "expect": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
