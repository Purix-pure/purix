# Purix local dev environment variables
# Copy this file to the repo root as `.env` (the real `.env` is gitignored,
# this template is not).
#
# `packages/cli/src/cli.ts` loads .env from your current directory via
# `import "dotenv/config"` as its first line, so values set here reach
# process.env automatically when you run `purix` from this project. For
# secrets you don't want sitting in a plaintext file at all, use
# `purix secret-set <name> <value>` instead — the CLI's built-in
# encrypted-at-rest store.

# --- LLM provider keys (only set the one(s) matching your chosen provider) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CUSTOM_API_KEY=

# Which provider Purix calls by default (or use `purix provider-set`)
# One of: anthropic | openai | gemini | custom
PURIX_LLM_PROVIDER=

# --- MCP server ---
PURIX_MCP_AGENT_ID=
PURIX_MCP_MAX_GATED_ACTIONS=

# --- Hosted API (only relevant if you use the closed-source hosted tier) ---
PURIX_API_URL=
PURIX_DEV_TIER=

# --- Cost / behavior controls ---
PURIX_COST_CEILING_USD=
PURIX_SCHEDULER_POLL_MS=
PURIX_QUIET=
AUTO_CONFIRM=

# --- Webhooks ---
PURIX_WEBHOOK_URL=
PURIX_WEBHOOK_SECRET=

# --- Misc ---
BRAND_SOCIAL_HANDLE=
PURIX_INTERNAL_LANGUAGES=